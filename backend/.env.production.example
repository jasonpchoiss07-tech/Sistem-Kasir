# ── Backend production environment ───────────────────────
# Copy to your hosting provider's environment variables (do NOT commit real values).

NODE_ENV=production
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slash).
# e.g. https://app.namatoko.com
CORS_ORIGIN=https://app.namatoko.com

# Managed PostgreSQL connection string from your provider (Supabase/Neon/RDS/...).
# NEVER use the local dev database here. Include sslmode=require if the provider needs it.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Strong random secret (e.g. `openssl rand -hex 32`). Server refuses to start
# in production if this is missing or left as the dev default.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h

# Shown on receipts.
STORE_NAME=Nama Toko Anda
